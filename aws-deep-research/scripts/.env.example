# Brave Search API Key
# Sign up: https://brave.com/search/api/
# Free tier: 1,000 requests/month (credit card required)
BRAVE_SEARCH_API_KEY=your_brave_key_here

# Tavily Search API Key
# Quickstart (no credit card): https://docs.tavily.com/documentation/quickstart
# Free tier credits info: https://docs.tavily.com/documentation/api-credits
# Free tier: 1,000 credits/month (basic search = 1 credit, advanced = 2)
TAVILY_API_KEY=tvly-your_tavily_key_here

# GitHub Personal Access Token
# Get yours at: https://github.com/settings/tokens
# Required for git-repo-research-mcp-server GitHub search (higher rate limits)
# If not set, GitHub repository search will be skipped
GITHUB_TOKEN=ghp_your_github_token_here

# Kroki Diagram Rendering (optional)
# Self-hosted: docker run -d -p 8000:8000 yuzutech/kroki
# Then set: KROKI_URL=http://localhost:8000
# If not set, only auto-detects local Docker; remote rendering is opt-in.
# Set to "disabled" to skip diagram generation entirely
# KROKI_URL=http://localhost:8000

# Report Output Directory
# Final research reports are copied here for easy access and safekeeping.
# Default: ~/.aws-deep-research/outputs
# REPORT_OUTPUT_DIR=~/.aws-deep-research/outputs

# Research Work Directory
# Intermediate artifacts (research-contract.md, aws-docs.md, web-content.md,
# downloads/, etc.) are written here — NOT into the invocation CWD.
# This prevents stray output/research/ folders from being scattered across
# every directory you invoke the skill from.
# Default: ~/.aws-deep-research/work
# RESEARCH_WORK_DIR=~/.aws-deep-research/work
